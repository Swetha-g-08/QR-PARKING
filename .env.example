# CampusPark Environment Variables Template
# Copy this file to .env for local testing (Do not commit .env to Git)

# Supabase / PostgreSQL Database Connection URL (Leave empty for local SQLite fallback)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Base Application URL used for generating production QR codes
BASE_URL=http://127.0.0.1:5000

# Secret Key for Flask Session Signing
SECRET_KEY=campuspark-production-secure-secret-key
